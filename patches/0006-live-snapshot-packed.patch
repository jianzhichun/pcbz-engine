# PCBZ render server patch 0006 (U5): the live control server answers project.snapshot_packed.
# Why: patch 0001 gave the headless engine a snapshot_project tool (method project.snapshot_packed). `pcbcraft-cli mcp --connect` serves the same
# tool list, so against a live editor it needs the live server to answer the same method, with the same reply. Also PcbApp::start_control:
# start the live endpoint from the host (loopback, request wait chosen by the host) and hand back (port, secret); no token or discovery file.

diff --git a/crates/app/src/embedded.rs b/crates/app/src/embedded.rs
index 0810f8e..d680fa4 100644
--- a/crates/app/src/embedded.rs
+++ b/crates/app/src/embedded.rs
@@ -60,6 +60,17 @@ impl PcbApp {
         self.message = reason.map(str::to_owned);
     }
 
+    /// Start the live control endpoint on a loopback port of its own and return `(port, secret)`
+    /// for the host to give `pcbcraft-cli mcp --connect`. Requests may wait `wait` for the editor
+    /// (the default two seconds would drop the reply of a command that outlives it, after the edit
+    /// applied). No token or discovery file is written. Starting it again replaces the endpoint.
+    pub fn start_control(&mut self, ctx: &egui::Context, wait: std::time::Duration) -> Result<(u16, String), String> {
+        let control = live_control::LiveControl::start_with_wait(ctx, wait).map_err(|e| e.to_string())?;
+        let endpoint = (control.port(), control.secret().to_owned());
+        self.live_control = Some(control);
+        Ok(endpoint)
+    }
+
     /// A project open (the startup one included) has not finished.
     pub fn is_busy(&self) -> bool {
         self.startup_open.is_some() || self.files.busy()
