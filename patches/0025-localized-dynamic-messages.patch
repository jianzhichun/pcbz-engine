+/// A browser task can yield while another session is using this thread. Enter the language
+/// on each poll and drop it before yielding rather than holding a locale guard across await.
+#[cfg(target_arch = "wasm32")]
+pub fn localized_future<F: std::future::Future>(future: F) -> impl std::future::Future<Output = F::Output> {
+    let language = solidcraft_ui_text::language();
+    let mut future = Box::pin(future);
+    std::future::poll_fn(move |cx| {
+        let _guard = solidcraft_ui_text::scope(language);
+        future.as_mut().poll(cx)
+    })
+}
+
+/// Capture the caller's locale at dispatch, then restore the worker's previous locale on return.
+pub fn localized_job<T>(job: impl FnOnce() -> T) -> impl FnOnce() -> T {
+    let language = solidcraft_ui_text::language();
+    move || {
+        let _guard = solidcraft_ui_text::scope(language);
+        job()
+    }
+}
+
+/// A grammatical suffix is not a standalone label (a user object can itself be named `s`).
+pub fn plural_suffix(suffix: &str) -> &str {
+    if solidcraft_ui_text::language() == CHINESE { "" } else { suffix }
+}
