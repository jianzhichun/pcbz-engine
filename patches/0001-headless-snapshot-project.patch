+/// The open project as the portable `.pc` archive the desktop app writes, base64-encoded, with
+/// the session revision it captures. The host stores it; this process writes no file.
+fn snapshot_packed(session: &Session) -> Result<Value, Failure> {
+    let project = session.snapshot().ok_or_else(|| Failure::new(ErrorCode::Unavailable, "no project is open"))?;
+    let documents = pcbcraft_engine::persistence::encode_documents(project).map_err(|e| Failure::new(ErrorCode::Unavailable, e))?;
+    let bytes = pcbcraft_engine::persistence::encode_deflated_packed_documents(documents).map_err(|e| Failure::new(ErrorCode::Unavailable, e))?;
+    Ok(json!({"revision": session.revision(), "bytes": bytes.len(), "archive_base64": base64(&bytes)}))
+}
+
+/// Standard base64 with padding (RFC 4648 section 4).
+fn base64(bytes: &[u8]) -> String {
+    const ALPHABET: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = String::with_capacity(bytes.len().div_ceil(3) * 4);
+    for chunk in bytes.chunks(3) {
+        let b = [chunk[0], chunk.get(1).copied().unwrap_or(0), chunk.get(2).copied().unwrap_or(0)];
+        let n = (u32::from(b[0]) << 16) | (u32::from(b[1]) << 8) | u32::from(b[2]);
+        for (i, shift) in [18u32, 12, 6, 0].into_iter().enumerate() {
+            if i <= chunk.len() {
+                out.push(char::from(ALPHABET[((n >> shift) & 63) as usize]));
+            } else {
+                out.push('=');
+            }
+        }
+    }
+    out
+}
