+++ b/crates/storage/src/library.rs
@@ -251,9 +251,21 @@ pub fn trash_library(root: &Path) -> Result<(), String> {
     trash_directory(root)
 }
 
+static TRASH_REFUSED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// A host that must start no helper process for the person's files (the editor drawn inside
+/// another application) calls this once: the system trash is then never asked, and a folder
+/// removal that needs it fails with its registration kept, as when the trash service is missing.
+pub fn refuse_system_trash() {
+    TRASH_REFUSED.store(true, std::sync::atomic::Ordering::Relaxed);
+}
+
 /// The item remover supplies a private recovery directory after validating and staging its
 /// exact records. Folder deletion validates its manifest before entering this shared adapter.
 fn trash_directory(root: &Path) -> Result<(), String> {
+    if TRASH_REFUSED.load(std::sync::atomic::Ordering::Relaxed) {
+        return Err("System trash is unavailable in this editor; registration retained".into());
+    }
