# PCBZ render server patch 0007 (U6): no system trash from the embedded app.
# Why: the one place the app starts gio / osascript / powershell for the person's files is the library folder trash. A host that must start
# no helper process calls pcbcraft_storage::library::refuse_system_trash (new_embedded does); the removal then fails, registration kept.

diff --git a/crates/app/src/embedded.rs b/crates/app/src/embedded.rs
index d680fa4..c9a59a8 100644
--- a/crates/app/src/embedded.rs
+++ b/crates/app/src/embedded.rs
@@ -17,6 +17,8 @@ impl PcbApp {
         // Detached editor windows become windows inside the host's surface (egui's embedded
         // viewports): there is no operating system to give them real ones.
         ctx.set_embed_viewports(true);
+        // No `gio`, `osascript` or `powershell` for the person's files from inside a host.
+        pcbcraft_storage::library::refuse_system_trash();
         let storage: Option<&dyn eframe::Storage> = None;
         let preferences = storage.and_then(|s| s.get_string(PREFERENCES_KEY)).map(|text| Preferences::parse(&text)).unwrap_or_default();
         let mut views = EditorViews::default();
