diff --git a/apps/pcbcraft-web/src/worker/input.rs b/apps/pcbcraft-web/src/worker/input.rs
new file mode 100644
index 0000000..0d43399
--- /dev/null
+++ b/apps/pcbcraft-web/src/worker/input.rs
@@ -0,0 +1,157 @@
+//! The page's input vocabulary mapped 1:1 to `egui::Event` (egui 0.37
+//! `crates/egui-0.37.0/src/data/input/event.rs:18-206`).
+//!
+//! Copied from the render server's `domain/input.rs` (PCBZ wasm page patch 0012) because that
+//! crate is a native binary (tokio, tungstenite, wgpu surface) and cannot be built for
+//! wasm32-unknown-unknown. Keep the two in step: the page sends the same `InputEvent` JSON to
+//! either editor, so a change here that the render server lacks would split the vocabulary.
+
+use serde::Deserialize;
+use serde_json::Value;
+
+/// The keys held, as the page sees them.
+#[derive(Clone, Copy, Debug, Default, Deserialize, PartialEq, Eq)]
+pub struct ModKeys {
+    pub alt: bool,
+    pub ctrl: bool,
+    pub shift: bool,
+    pub meta: bool,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+pub enum ButtonName {
+    Primary,
+    Secondary,
+    Middle,
+    Extra1,
+    Extra2,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "lowercase")]
+pub enum WheelUnit {
+    Point,
+    Line,
+    Page,
+}
+
+/// One input event as the wire carries it (`"e"` names the kind).
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+#[serde(tag = "e", rename_all = "snake_case")]
+pub enum InputEvent {
+    Move { x: f32, y: f32 },
+    Button { x: f32, y: f32, button: ButtonName, pressed: bool, mods: ModKeys },
+    Gone,
+    Wheel { dx: f32, dy: f32, unit: WheelUnit, mods: ModKeys },
+    Zoom { factor: f32 },
+    Key { key: String, physical: Option<String>, pressed: bool, repeat: bool, mods: ModKeys },
+    Text { text: String },
+    Preedit { text: String, range: Option<[u32; 2]> },
+    Commit { text: String },
+    DeleteSurrounding { before: u32, after: u32 },
+    Copy,
+    Cut,
+    Paste { text: String },
+    Focus { focused: bool },
+    Mods { mods: ModKeys },
+}
+
+/// Read each event on its own; one this version does not know (or that does not read) is
+/// dropped and counted, the rest go on.
+pub fn parse_events(values: &[Value]) -> (Vec<InputEvent>, usize) {
+    let mut dropped = 0;
+    let events = values
+        .iter()
+        .filter_map(|v| {
+            let parsed = InputEvent::deserialize(v).ok();
+            dropped += usize::from(parsed.is_none());
+            parsed
+        })
+        .collect();
+    (events, dropped)
+}
+
+/// How page input becomes UI input on this system.
+#[derive(Clone, Copy, Debug)]
+pub struct Translator {
+    /// The render server runs on macOS: the command key is meta there, ctrl elsewhere (what
+    /// egui-winit does for a native window; the page cannot know).
+    pub mac: bool,
+}
+
+impl Translator {
+    pub fn native() -> Self {
+        Translator { mac: cfg!(target_os = "macos") }
+    }
+
+    /// `egui::Modifiers` (`data/input/modifiers.rs:19-37`) for the keys the page holds.
+    pub fn modifiers(&self, m: ModKeys) -> egui::Modifiers {
+        egui::Modifiers { alt: m.alt, ctrl: m.ctrl, shift: m.shift, mac_cmd: self.mac && m.meta, command: if self.mac { m.meta } else { m.ctrl } }
+    }
+
+    /// The UI event for `ev`. `points_per_css`: UI points per CSS pixel (1 / the UI's zoom),
+    /// for positions and point-unit wheel deltas. `None`: an event the UI has no use for (a key
+    /// neither of whose names it knows, empty text).
+    pub fn event(&self, ev: InputEvent, points_per_css: f32) -> Option<egui::Event> {
+        let at = |x: f32, y: f32| egui::pos2(x * points_per_css, y * points_per_css);
+        Some(match ev {
+            InputEvent::Move { x, y } => egui::Event::PointerMoved(at(x, y)),
+            InputEvent::Button { x, y, button, pressed, mods } => {
+                egui::Event::PointerButton { pos: at(x, y), button: pointer_button(button), pressed, modifiers: self.modifiers(mods) }
+            }
+            InputEvent::Gone => egui::Event::PointerGone,
+            InputEvent::Wheel { dx, dy, unit, mods } => {
+                let scale = if unit == WheelUnit::Point { points_per_css } else { 1.0 };
+                egui::Event::MouseWheel {
+                    unit: wheel_unit(unit),
+                    delta: egui::vec2(dx * scale, dy * scale),
+                    phase: egui::TouchPhase::Move,
+                    source: egui::MouseWheelSource::Unknown,
+                    modifiers: self.modifiers(mods),
+                }
+            }
+            InputEvent::Zoom { factor } => egui::Event::Zoom(factor),
+            InputEvent::Key { key, physical, pressed, repeat, mods } => {
+                // Browser names (`ArrowDown`, `KeyA`, `Digit0`) are what `Key::from_name` reads
+                // (`data/key.rs:503`), as eframe's web runner does it.
+                let physical_key = physical.as_deref().and_then(egui::Key::from_name);
+                let key = egui::Key::from_name(&key).or(physical_key)?;
+                egui::Event::Key { key, physical_key, pressed, repeat, modifiers: self.modifiers(mods) }
+            }
+            InputEvent::Text { text } if text.is_empty() => return None,
+            InputEvent::Text { text } => egui::Event::Text(text),
+            InputEvent::Preedit { text, range } => {
+                egui::Event::Ime(egui::ImeEvent::Preedit { text, active_range_chars: range.map(|[a, b]| a.min(b) as usize..a.max(b) as usize) })
+            }
+            InputEvent::Commit { text } => egui::Event::Ime(egui::ImeEvent::Commit(text)),
+            InputEvent::DeleteSurrounding { before, after } => {
+                egui::Event::Ime(egui::ImeEvent::DeleteSurrounding { before_chars: before as usize, after_chars: after as usize })
+            }
+            InputEvent::Copy => egui::Event::Copy,
+            InputEvent::Cut => egui::Event::Cut,
+            // As egui-winit pastes: Windows line ends become `\n`.
+            InputEvent::Paste { text } => egui::Event::Paste(text.replace("\r\n", "\n")),
+            InputEvent::Focus { focused } => egui::Event::WindowFocused(focused),
+            InputEvent::Mods { mods } => egui::Event::ModifiersChanged(self.modifiers(mods)),
+        })
+    }
+}
+
+fn pointer_button(b: ButtonName) -> egui::PointerButton {
+    match b {
+        ButtonName::Primary => egui::PointerButton::Primary,
+        ButtonName::Secondary => egui::PointerButton::Secondary,
+        ButtonName::Middle => egui::PointerButton::Middle,
+        ButtonName::Extra1 => egui::PointerButton::Extra1,
+        ButtonName::Extra2 => egui::PointerButton::Extra2,
+    }
+}
+
+fn wheel_unit(u: WheelUnit) -> egui::MouseWheelUnit {
+    match u {
+        WheelUnit::Point => egui::MouseWheelUnit::Point,
+        WheelUnit::Line => egui::MouseWheelUnit::Line,
+        WheelUnit::Page => egui::MouseWheelUnit::Page,
+    }
+}
diff --git a/apps/pcbcraft-web/src/worker/mod.rs b/apps/pcbcraft-web/src/worker/mod.rs
new file mode 100644
index 0000000..0275ee3
--- /dev/null
+++ b/apps/pcbcraft-web/src/worker/mod.rs
@@ -0,0 +1,417 @@
+//! PCBZ wasm page patch 0012: the editor loop on a worker-owned OffscreenCanvas.
+//!
+//! Why: the page and the chat share the host's one main thread; red line a forbids running the
+//! single-threaded wasm editor there. This module is the worker-side host: it turns a transferred
+//! `OffscreenCanvas` into a wgpu surface (WebGPU, else WebGL2 through wgpu's GL backend), builds
+//! `PcbApp` with the wasm constructor, runs one egui pass per call with the page's input
+//! vocabulary (the render server's `domain/input.rs`, copied here because that crate is native),
+//! and paints into the canvas itself -- no frame crosses to the main thread. The existing
+//! `pcbz_host_*` exports (patch 0011) stay the only load/save path; egui's repaint request calls
+//! the page's `pcbzWorkerWake`, so an idle editor still answers a queued host request.
+//!
+//! Not in eframe: `WebRunner` takes an `HtmlCanvasElement` and a `document` for focus, IME and
+//! events, none of which exist in a worker. The wgpu surface is `SurfaceTarget::OffscreenCanvas`,
+//! which wgpu supports (no upstream eframe change is needed for the surface itself).
+
+use std::cell::RefCell;
+
+// eframe re-exports the renderer it was built with, so the page does not add a second source for it.
+use eframe::egui_wgpu::{self, wgpu};
+use wasm_bindgen::prelude::*;
+use web_sys::OffscreenCanvas;
+
+mod input;
+
+// The one editor a worker has.
+thread_local! {
+    static EDITOR: RefCell<Option<Editor>> = RefCell::new(None);
+    /// The page's wake function. egui requires its repaint callback to be `Send + Sync`; a
+    /// `js_sys::Function` is neither, so the callback captures nothing and reaches this slot.
+    static WAKE: RefCell<Option<js_sys::Function>> = const { RefCell::new(None) };
+}
+
+/// What one pass produced for the page (JSON; the page applies cursor, clipboard and IME).
+#[derive(Default, serde::Serialize)]
+struct Report {
+    painted: bool,
+    repaint: bool,
+    delay_ms: f64,
+    cursor: String,
+    copied: Vec<String>,
+    paste: bool,
+    ime: bool,
+    ime_interrupt: bool,
+    pulse: u64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    error: Option<String>,
+}
+
+/// Owned web display handle for wgpu (`!Send`/`!Sync` raw pointers are not involved on web).
+#[derive(Clone, Debug)]
+struct WebDisplay;
+
+impl wgpu::rwh::HasDisplayHandle for WebDisplay {
+    fn display_handle(&self) -> Result<wgpu::rwh::DisplayHandle<'_>, wgpu::rwh::HandleError> {
+        Ok(wgpu::rwh::DisplayHandle::web())
+    }
+}
+
+struct Editor {
+    ctx: egui::Context,
+    app: pcbcraft_app::PcbApp,
+    /// Declared before the instance it was made from, and the device it draws with, so it is
+    /// dropped first (Rust drops fields in declaration order).
+    surface: wgpu::Surface<'static>,
+    /// Kept beside the surface: wgpu's own painter keeps its instance too.
+    instance: wgpu::Instance,
+    config: wgpu::SurfaceConfiguration,
+    rs: egui_wgpu::RenderState,
+    deltas: egui::TexturesDelta,
+    canvas: OffscreenCanvas,
+    css_w: f32,
+    css_h: f32,
+    dpr: f32,
+    focused: bool,
+    theme: egui::Theme,
+    translator: input::Translator,
+    started: f64,
+    max_texture_side: usize,
+    configure: bool,
+    pulse: u64,
+    #[cfg(feature = "proof")]
+    debug_text: Option<String>,
+}
+
+/// Device pixels for `css` at `dpr` (at least one; a zero-size surface has no frame).
+fn pixels(css: f32, dpr: f32) -> u32 {
+    (css * dpr).round().max(1.0) as u32
+}
+
+fn now_sec() -> f64 {
+    js_sys::Date::now() / 1000.0
+}
+
+/// Route egui's repaint request to the page's scheduler. Called with the context locked, so the
+/// callback only calls one JS function; the page posts a pump (rAF in a worker where present,
+/// otherwise a timer).
+fn install_wake(ctx: &egui::Context) {
+    let global = js_sys::global();
+    if let Ok(value) = js_sys::Reflect::get(&global, &JsValue::from_str("pcbzWorkerWake"))
+        && let Ok(wake) = value.dyn_into::<js_sys::Function>()
+    {
+        WAKE.with(|slot| *slot.borrow_mut() = Some(wake));
+    }
+    // Captures nothing: egui's callback bound is `Send + Sync`, which a JS function cannot meet.
+    ctx.set_request_repaint_callback(|_info| {
+        WAKE.with(|slot| {
+            if let Some(wake) = slot.borrow().as_ref() {
+                let _ = wake.call0(&JsValue::NULL);
+            }
+        });
+    });
+}
+
+/// Start the editor on a transferred canvas. `font` is the page's OFL CJK subset (empty: none).
+#[allow(clippy::too_many_arguments)]
+pub async fn start(
+    canvas: OffscreenCanvas,
+    css_w: f32,
+    css_h: f32,
+    dpr: f32,
+    dark: bool,
+    mac: bool,
+    font: &[u8],
+) -> Result<(), JsValue> {
+    let px_w = pixels(css_w, dpr);
+    let px_h = pixels(css_h, dpr);
+    canvas.set_width(px_w);
+    canvas.set_height(px_h);
+
+    let mut setup = egui_wgpu::WgpuSetupCreateNew::without_display_handle();
+    setup.display_handle = Some(Box::new(WebDisplay));
+    let web = egui_wgpu::WgpuConfiguration { wgpu_setup: egui_wgpu::WgpuSetup::CreateNew(setup), ..Default::default() };
+    let instance = web.wgpu_setup.new_instance().await;
+    let surface = instance
+        .create_surface(wgpu::SurfaceTarget::OffscreenCanvas(canvas.clone()))
+        .map_err(|error| JsValue::from_str(&format!("graphics surface: {error}")))?;
+    let options = egui_wgpu::RendererOptions { msaa_samples: 1, depth_stencil_format: None, ..Default::default() };
+    let rs = egui_wgpu::RenderState::create(&web, &instance, Some(&surface), options)
+        .await
+        .map_err(|error| JsValue::from_str(&format!("graphics device: {error}")))?;
+    let Some(mut config) = surface.get_default_config(&rs.adapter, px_w, px_h) else {
+        return Err(JsValue::from_str("graphics: the canvas surface is not supported"));
+    };
+    config.format = rs.target_format;
+    config.width = px_w;
+    config.height = px_h;
+    surface.configure(&rs.device, &config);
+    let max_texture_side = rs.device.limits().max_texture_dimension_2d as usize;
+
+    if !font.is_empty() {
+        pcbcraft_chrome::fonts::set_bundled_cjk(font.to_vec());
+    }
+    let ctx = egui::Context::default();
+    install_wake(&ctx);
+    let app = pcbcraft_app::PcbApp::new_worker(&ctx);
+
+    let editor = Editor {
+        ctx,
+        app,
+        surface,
+        instance,
+        config,
+        rs,
+        deltas: egui::TexturesDelta::default(),
+        canvas,
+        css_w,
+        css_h,
+        dpr,
+        focused: true,
+        theme: if dark { egui::Theme::Dark } else { egui::Theme::Light },
+        translator: input::Translator { mac },
+        started: now_sec(),
+        max_texture_side,
+        configure: false,
+        pulse: 0,
+        #[cfg(feature = "proof")]
+        debug_text: None,
+    };
+    EDITOR.with(|slot| *slot.borrow_mut() = Some(editor));
+    Ok(())
+}
+
+/// One pass with the page's input batch (JSON array in the render server's InputEvent vocabulary).
+pub fn frame(input_json: &str) -> String {
+    let mut report = Report::default();
+    EDITOR.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let Some(editor) = slot.as_mut() else {
+            report.error = Some("editor not started".to_owned());
+            return;
+        };
+        if let Err(error) = editor.pass(input_json, &mut report) {
+            report.error = Some(error);
+        }
+    });
+    serde_json::to_string(&report).unwrap_or_else(|_| "{}".to_owned())
+}
+
+/// The page's resize (CSS pixels and device pixel ratio).
+pub fn resize(css_w: f32, css_h: f32, dpr: f32) {
+    EDITOR.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let Some(editor) = slot.as_mut() else { return };
+        editor.css_w = css_w.max(1.0);
+        editor.css_h = css_h.max(1.0);
+        editor.dpr = dpr.max(0.1);
+        editor.canvas.set_width(pixels(editor.css_w, editor.dpr));
+        editor.canvas.set_height(pixels(editor.css_h, editor.dpr));
+        editor.configure = true;
+    });
+}
+
+/// The graphics backend this worker got (the page's runtime probe reports it; booleans only, no user data).
+pub fn probe() -> String {
+    EDITOR.with(|slot| {
+        let borrow = slot.borrow();
+        let Some(editor) = borrow.as_ref() else {
+            return "{\"backend\":\"none\"}".to_owned();
+        };
+        let info = editor.rs.adapter.get_info();
+        serde_json::json!({
+            "backend": format!("{:?}", info.backend),
+            "device": format!("{:?}", info.device_type),
+        })
+        .to_string()
+    })
+}
+
+/// The page's focus change (the canvas has no DOM focus of its own in a worker).
+pub fn set_focus(focused: bool) {
+    EDITOR.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if let Some(editor) = slot.as_mut() {
+            editor.focused = focused;
+        }
+    });
+}
+
+/// The page's proof overlay: draw `text` on top of the next pass, in the bundled CJK face.
+#[cfg(feature = "proof")]
+pub fn debug_text(text: &str) {
+    EDITOR.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if let Some(editor) = slot.as_mut() {
+            editor.debug_text = Some(text.to_owned());
+        }
+    });
+}
+
+impl Editor {
+    fn pass(&mut self, input_json: &str, report: &mut Report) -> Result<(), String> {
+        self.pulse += 1;
+        report.pulse = self.pulse;
+        let values = if input_json.trim().is_empty() {
+            Vec::new()
+        } else {
+            serde_json::from_str::<Vec<serde_json::Value>>(input_json).map_err(|error| format!("input: {error}"))?
+        };
+        let (events, _dropped) = input::parse_events(&values);
+        let points_per_css = 1.0 / self.ctx.zoom_factor().max(0.01);
+        let events: Vec<egui::Event> = events.into_iter().filter_map(|event| self.translator.event(event, points_per_css)).collect();
+        let raw = self.raw_input(events);
+        let ctx = self.ctx.clone();
+        let app = &mut self.app;
+        #[cfg(feature = "proof")]
+        let proof = self.debug_text.clone();
+        let full = ctx.run_ui(raw, |ui| {
+            app.frame(ui);
+            #[cfg(feature = "proof")]
+            if let Some(text) = proof.as_deref() {
+                overlay(ui, text);
+            }
+        });
+
+        let egui::FullOutput { platform_output, textures_delta, shapes, pixels_per_point, mut viewport_output, .. } = full;
+        self.deltas.append(textures_delta);
+        let root = viewport_output.remove(&egui::ViewportId::ROOT);
+        let repaint_delay = root.as_ref().map_or(std::time::Duration::MAX, |output| output.repaint_delay);
+        report.repaint = repaint_delay < std::time::Duration::MAX;
+        report.delay_ms = if report.repaint { repaint_delay.as_secs_f64() * 1000.0 } else { 0.0 };
+        report.paste = root.into_iter().flat_map(|output| output.commands).any(|command| matches!(command, egui::ViewportCommand::RequestPaste));
+        report.cursor = format!("{:?}", platform_output.cursor_icon);
+        report.copied = platform_output
+            .commands
+            .iter()
+            .filter_map(|command| match command {
+                egui::OutputCommand::CopyText(text) => Some(text.clone()),
+                _ => None,
+            })
+            .collect();
+        report.ime = platform_output.ime.is_some();
+        report.ime_interrupt = platform_output.ime.as_ref().is_some_and(|ime| ime.should_interrupt_composition);
+
+        let dirty = !shapes.is_empty() || !self.deltas.set.is_empty() || report.repaint;
+        if dirty {
+            report.painted = self.paint(shapes, pixels_per_point)?;
+        }
+        Ok(())
+    }
+
+    fn raw_input(&self, events: Vec<egui::Event>) -> egui::RawInput {
+        let zoom = self.ctx.zoom_factor().max(0.01);
+        let points = egui::vec2((self.css_w / zoom).max(1.0), (self.css_h / zoom).max(1.0));
+        let rect = egui::Rect::from_min_size(egui::Pos2::ZERO, points);
+        let viewport = egui::ViewportInfo {
+            native_pixels_per_point: Some(self.dpr),
+            monitor_size: Some(points),
+            inner_rect: Some(rect),
+            outer_rect: Some(rect),
+            minimized: Some(false),
+            maximized: Some(false),
+            fullscreen: Some(false),
+            focused: Some(self.focused),
+            occluded: Some(false),
+            ..Default::default()
+        };
+        egui::RawInput {
+            viewport_id: egui::ViewportId::ROOT,
+            viewports: std::iter::once((egui::ViewportId::ROOT, viewport)).collect(),
+            screen_rect: Some(rect),
+            max_texture_side: Some(self.max_texture_side),
+            time: Some(now_sec() - self.started),
+            events,
+            focused: self.focused,
+            system_theme: Some(self.theme),
+            ..Default::default()
+        }
+    }
+
+    fn paint(&mut self, shapes: Vec<egui::epaint::ClippedShape>, pixels_per_point: f32) -> Result<bool, String> {
+        let primitives = self.ctx.tessellate(shapes, pixels_per_point);
+        let width = pixels(self.css_w, self.dpr);
+        let height = pixels(self.css_h, self.dpr);
+        if self.config.width != width || self.config.height != height {
+            self.config.width = width;
+            self.config.height = height;
+            self.configure = true;
+        }
+        if self.configure {
+            self.surface.configure(&self.rs.device, &self.config);
+            self.configure = false;
+        }
+        let screen = egui_wgpu::ScreenDescriptor { size_in_pixels: [width, height], pixels_per_point };
+        let mut encoder = self.rs.device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("pcbz-wasm egui") });
+        let user_buffers = {
+            let mut renderer = self.rs.renderer.write();
+            for (id, deltas) in self.deltas.set.drain() {
+                for delta in deltas {
+                    renderer.update_texture(&self.rs.device, &self.rs.queue, id, &delta);
+                }
+            }
+            renderer.update_buffers(&self.rs.device, &self.rs.queue, &mut encoder, &primitives, &screen)
+        };
+        let frame = match self.surface.get_current_texture() {
+            wgpu::CurrentSurfaceTexture::Success(frame) => Some(frame),
+            wgpu::CurrentSurfaceTexture::Suboptimal(frame) => {
+                self.configure = true;
+                Some(frame)
+            }
+            _ => {
+                self.configure = true;
+                None
+            }
+        };
+        let mut painted = false;
+        if let Some(frame) = frame {
+            let view = frame.texture.create_view(&wgpu::TextureViewDescriptor::default());
+            let mut clear = self.ctx.global_style().visuals.panel_fill.to_normalized_gamma_f32();
+            clear[3] = 1.0;
+            {
+                let renderer = self.rs.renderer.read();
+                let pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("pcbz-wasm egui pass"),
+                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                        view: &view,
+                        resolve_target: None,
+                        ops: wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(wgpu::Color {
+                                r: clear[0] as f64,
+                                g: clear[1] as f64,
+                                b: clear[2] as f64,
+                                a: clear[3] as f64,
+                            }),
+                            store: wgpu::StoreOp::Store,
+                        },
+                        depth_slice: None,
+                    })],
+                    depth_stencil_attachment: None,
+                    timestamp_writes: None,
+                    occlusion_query_set: None,
+                    multiview_mask: None,
+                });
+                renderer.render(&mut pass.forget_lifetime(), &primitives, &screen);
+            }
+            self.rs.queue.submit(user_buffers.into_iter().chain([encoder.finish()]));
+            self.rs.queue.present(frame);
+            painted = true;
+        }
+        {
+            let mut renderer = self.rs.renderer.write();
+            for id in self.deltas.free.drain() {
+                renderer.free_texture(&id);
+            }
+        }
+        Ok(painted)
+    }
+}
+
+/// Proof-only overlay: black plate, white Chinese text; the workflow checks its pixels.
+#[cfg(feature = "proof")]
+fn overlay(ui: &egui::Ui, text: &str) {
+    egui::Area::new(egui::Id::new("pcbz-cjk-proof")).fixed_pos(egui::pos2(8.0, 8.0)).order(egui::Order::Foreground).show(ui.ctx(), |ui| {
+        egui::Frame::new().fill(egui::Color32::BLACK).inner_margin(egui::Margin::same(8)).show(ui, |ui| {
+            ui.label(egui::RichText::new(text).size(28.0).color(egui::Color32::WHITE));
+        });
+    });
+}
