--- /dev/null
+++ b/crates/app/src/worker_app.rs
@@ -0,0 +1,44 @@
+//! PCBZ wasm page patch 0012: the editor without a document, for the page's worker.
+//!
+//! Why: the page runs the editor on an `OffscreenCanvas` inside a dedicated Worker (red line a:
+//! never on the host's main thread). A worker has no `window`, `document`, eframe
+//! `CreationContext` or `LocalStorage`, so `PcbApp::new` cannot build the app there, and
+//! `new_embedded` (patch 0002) is the native render server's constructor only. This file adds the
+//! wasm-side constructor and the read-only switch the page's licence gate drives; nothing
+//! existing is changed or read differently.
+
+use super::*;
+
+impl PcbApp {
+    /// What `new` builds with no storage and no document: installs the interface fonts (the
+    /// page pushes its bundled CJK face into `pcbcraft_chrome::fonts` first), default
+    /// preferences, and Home until the host page pushes project bytes through `pcbz_host_open`.
+    pub fn new_worker(ctx: &egui::Context) -> Self {
+        crate::host::set_host_page();
+        pcbcraft_chrome::install(ctx);
+        let preferences = Preferences::default();
+        let mut views = EditorViews::default();
+        views.set_grid_defaults(preferences.schematic_grid_nm, preferences.board_grid_nm);
+        Self {
+            library_sources: native_sources::Sources::restore(None),
+            home: true,
+            properties_open: true,
+            arrangements: arrangements::Arrangements::from_storage(None),
+            preferences,
+            library_preferences: placement_filters::Settings::parse(None),
+            board_appearance: board_appearance::Appearance::from_storage(None),
+            routing_presets: board_presets::Presets::from_storage(None),
+            views,
+            ..Self::default()
+        }
+    }
+
+    /// Make the live session read-only with `reason` (shown on the status bar), or editable again
+    /// with `None`. The page asks for this from `state.read_only` and whenever the licence's view
+    /// gate refuses; the save route refuses as well, so the bytes cannot reach disk either way.
+    pub fn set_read_only(&mut self, reason: Option<&str>) {
+        use pcbcraft_engine::SessionScope;
+        self.session.set_scope(if reason.is_some() { SessionScope::ReadOnly } else { SessionScope::Edit });
+        self.message = reason.map(str::to_owned);
+    }
+}
