 const VERSION: &str = env!("CARGO_PKG_VERSION");
 const BUG_REPORT_URL: &str = "https://github.com/tangency-labs/pcbcraft/issues/new";
+
+/// A host draws this build (the native render server's `new_embedded`, the wasm page's worker): the app is not the
+/// upstream project's own product then, and no link may leave it for the upstream site (patch 0014).
+static HOST_BUILD: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Mark this process as a host's build (patches 0010 and 0012 call it from their constructors).
+pub(crate) fn mark_host_build() {
+    HOST_BUILD.store(true, std::sync::atomic::Ordering::Relaxed);
+}
+
+#[cfg(target_arch = "wasm32")]
+fn wasm_host_page() -> bool {
+    crate::host::host_page()
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn wasm_host_page() -> bool {
+    false
+}
+
+/// Is the app drawn inside a host (so upstream links stay out of it)?
+fn host_build() -> bool {
+    HOST_BUILD.load(std::sync::atomic::Ordering::Relaxed) || wasm_host_page()
+}
 const PREFERENCES_KEY: &str = "pcbcraft.preferences";
