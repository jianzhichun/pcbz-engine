# patch 0014: no upstream links in a host build
#
# Why: in the native render server (patch 0010) and the wasm page (patch 0012) the app is drawn inside AngAI, a
# different product: user-visible text and links must not carry the upstream project name or open its pages. Host builds
# get no "Report a bug" button, no Help -> Report an Issue item and no link in About; a part's datasheet links are the
# user data and stay.
#
# files: crates/app/src/lib.rs (the host flag and the four gated sites), embedded.rs / worker_app.rs (their constructors
# mark the build). Additive and guarded; a normal desktop build is unchanged.

diff --git a/crates/app/src/embedded.rs b/crates/app/src/embedded.rs
index 33b43d1..21b58ba 100644
--- a/crates/app/src/embedded.rs
+++ b/crates/app/src/embedded.rs
@@ -18,6 +18,7 @@ impl PcbApp {
     /// preferences, Home until `project` (a `.pc` archive, a project folder or its `project.json`)
     /// has opened through the ordinary file worker on the first drawn frame.
     pub fn new_embedded(ctx: &egui::Context, project: Option<std::path::PathBuf>) -> Self {
+        crate::mark_host_build();
         pcbcraft_chrome::install(ctx);
         // Detached editor windows become windows inside the host's surface (egui's embedded
         // viewports): there is no operating system to give them real ones.
