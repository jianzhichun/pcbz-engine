+/// Return whether the highest-priority nonempty POSIX locale variable normalizes to Simplified
+/// Chinese (the base `zh`, `zh-Hans`, or a Simplified region; a Traditional tag is not this build's).
+#[cfg(any(not(target_arch = "wasm32"), test))]
+fn resolve_posix_env_chinese(mut get_var: impl FnMut(&str) -> Option<String>) -> bool {
+    let Some(first_nonempty) = ["LC_ALL", "LC_MESSAGES", "LANG"].into_iter().find_map(|var| get_var(var).filter(|val| !val.trim().is_empty())) else {
+        return false;
+    };
