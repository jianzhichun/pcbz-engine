+}
+
+/// The page's interface language: `zh` (default), `en`, `he`, or `system`.
+#[cfg(target_arch = "wasm32")]
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn pcbz_worker_set_language(language: &str) {
+    use pcbcraft_app::LanguageChoice;
+    let choice = match language.trim().to_ascii_lowercase().as_str() {
+        "en" | "en-us" => LanguageChoice::English,
+        "he" | "iw" => LanguageChoice::Hebrew,
+        "system" => LanguageChoice::System,
+        _ => LanguageChoice::Chinese,
+    };
+    worker::set_language(choice);
+}
