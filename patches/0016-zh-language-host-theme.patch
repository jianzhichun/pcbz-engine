+/// Whether a normalized `zh-*` tag asks for Traditional Chinese (`Hant`, `TW`, `HK`, `MO`).
+fn is_traditional_chinese(normalized: &str) -> bool {
+    let mut parts = normalized.split('-').skip(1);
+    let mut traditional = false;
+    for part in parts.by_ref() {
+        if part.len() == 4 {
+            traditional = part.eq_ignore_ascii_case("hant");
+            break;
+        }
+        if ["tw", "hk", "mo"].iter().any(|region| part.eq_ignore_ascii_case(region)) {
+            traditional = true;
+        }
+    }
+    traditional
+}
