+/// The page's host switched light/dark: repaint in the new palette without dropping state or undo.
+#[cfg(target_arch = "wasm32")]
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn pcbz_worker_theme(dark: bool) {
