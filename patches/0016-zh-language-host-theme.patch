+/// The page's host switched light/dark: swap the palette and ask for one pass. The document,
+/// selection and undo stack are untouched; the next pass repaints the canvas.
+pub fn set_theme(dark: bool) {
+    EDITOR.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let Some(editor) = slot.as_mut() else { return };
+        editor.theme = if dark { egui::Theme::Dark } else { egui::Theme::Light };
+        editor.app.set_host_theme(dark);
+        editor.ctx.request_repaint();
+    });
+}
+
+/// The page's interface language (`zh` unless its host asked for `en`).
+pub fn set_language(language: pcbcraft_app::LanguageChoice) {
+    EDITOR.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        if let Some(editor) = slot.as_mut() {
+            editor.app.set_language(language);
+            editor.ctx.request_repaint();
+        }
+    });
+}
