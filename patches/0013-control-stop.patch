+/// The one cancellable operation on this endpoint (patch 0013).
+///
+/// A `pcb.check_design` model call is answered by a deferred job on its own worker thread
+/// (`RemoteCheck`); `ui.operations {cancel: "agent"}` therefore arrives while the editor is free
+/// to draw and is handled by the socket worker itself, not queued behind the editor's frame. The
+/// worker only raises `requested`; the editor observes it on the next frame, cancels the queue and
+/// answers the in-flight request with a `stopped: ... nothing was applied` failure.
+#[derive(Debug, Default)]
+pub(super) struct AgentCancel {
+    /// A cancel that has not been observed yet.
+    requested: AtomicBool,
+    /// A deferred job that the next frame can stop is in flight.
+    in_flight: AtomicBool,
+    /// How many cancel requests were answered `cancelled` (diagnostics).
+    cancelled: AtomicU64,
+}
+
+impl AgentCancel {
+    /// Mark a cancellable job started; the editor clears it when the request is answered.
+    fn begin(&self) {
+        self.in_flight.store(true, Ordering::Release);
+    }
+
+    /// Mark the job answered (normally, stale or stopped).
+    fn end(&self) {
+        self.in_flight.store(false, Ordering::Release);
+        self.requested.store(false, Ordering::Release);
+    }
+
+    /// Answer `ui.operations {cancel: "agent"}` from a socket worker: raise the flag and report
+    /// whether a job was in flight. A job that lands before the editor reads the flag answers
+    /// with its own result, which the caller reports as landed; that race is not an error.
+    fn request_cancel(&self) -> bool {
+        if !self.in_flight.load(Ordering::Acquire) {
+            return false;
+        }
+        self.requested.store(true, Ordering::Release);
+        self.cancelled.fetch_add(1, Ordering::AcqRel);
+        true
+    }
+
+    /// Take a pending cancel for the editor's next frame.
+    fn take_request(&self) -> bool {
+        self.requested.swap(false, Ordering::AcqRel)
+    }
+}
