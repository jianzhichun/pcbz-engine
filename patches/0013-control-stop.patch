+/// The reply to `ui.operations` (patch 0013). `cancel: "agent"` stops the in-flight
+/// control-channel job; any other shape is refused without touching the editor. The refusal is
+/// ordinary JSON an unmodified client treats as a tool error (`error` + `code`), with `ok` for
+/// hosts that read the shared browser/node control client's envelope.
+fn operations_reply(agent: &AgentCancel, params: &Value) -> Value {
+    match params["cancel"].as_str() {
+        Some("agent") => {
+            if agent.request_cancel() {
+                json!({"ok": true, "result": {"cancelled": "agent"}})
+            } else {
+                json!({
+                    "ok": false,
+                    "error": "no operation `agent` is under way",
+                    "code": ErrorCode::Cancelled.as_str(),
+                    "details": {},
+                })
+            }
+        }
+        Some(other) => json!({
+            "ok": false,
+            "error": format!("no operation `{other}` is under way"),
+            "code": ErrorCode::InvalidRequest.as_str(),
+            "details": {},
+        }),
+        None => json!({
+            "ok": false,
+            "error": "ui.operations needs `cancel`: \"agent\"",
+            "code": ErrorCode::InvalidRequest.as_str(),
+            "details": {},
+        }),
+    }
+}
+
+/// The answer a stopped control-channel job gives its caller. The `stopped:` prefix is the
+/// product's stop marker: the caller must report this as a stop, not as a failure of the design.
+fn stopped_failure(operation: &str) -> Failure {
+    Failure::new(ErrorCode::Cancelled, format!("stopped: `{operation}` was canceled while it computed; nothing was applied"))
+}
