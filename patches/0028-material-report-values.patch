+/// The report basis is a model enum; translate its caption, never its serialized value.
+fn report_basis(basis: ReportBasis) -> &'static str {
+    tr_label(match basis {
+        ReportBasis::Typical => "Typical",
+        ReportBasis::Minimum => "Minimum",
+        ReportBasis::Maximum => "Maximum",
+        ReportBasis::Measured => "Measured",
+    })
