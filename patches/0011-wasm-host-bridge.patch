+    /// Apply requests the host page queued across the wasm boundary: open its project bytes,
+    /// save the open project, or run one catalog command. Each goes through the path a menu
+    /// action uses; a request that cannot start yet stays queued for the next frame.
+    #[cfg(target_arch = "wasm32")]
+    fn host_tick(&mut self, ctx: &egui::Context) {
+        for _ in 0..8 {
+            let Some(request) = host::take() else { break };
+            match request {
+                host::Request::Open(bytes) => {
+                    if self.files.busy() {
+                        host::retry(host::Request::Open(bytes));
+                        break;
+                    }
+                    if let Err(error) = self.files.open_host(bytes, self.session.revision(), ctx) {
+                        self.message = Some(error);
+                    }
+                }
+                host::Request::Save => {
+                    if self.session.project().is_none() || self.files.busy() {
+                        host::retry(host::Request::Save);
+                        break;
+                    }
+                    self.save_project_file(None, ctx);
+                }
+                host::Request::Command { id, params } => {
+                    if self.files.busy() {
+                        host::retry(host::Request::Command { id, params });
+                        break;
+                    }
+                    let params = serde_json::from_str(&params).unwrap_or(Value::Null);
+                    self.run(&id, &params);
+                    self.repaint_editors(ctx);
+                }
+            }
+        }
+        let project = self.session.project().map(|project| project.name.clone());
+        host::publish_status(
+            json!({
+                "revision": self.session.revision(),
+                "busy": self.files.busy(),
+                "home": self.home,
+                "project": project,
+            })
+            .to_string(),
+        );
+    }
