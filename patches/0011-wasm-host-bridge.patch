+    #[cfg(target_arch = "wasm32")]
+    pub(super) fn open_host(&mut self, bytes: Arc<[u8]>, revision: u64, ctx: &egui::Context) -> Result<(), String> {
+        if self.busy() {
+            return Err("A project file operation is already running".to_owned());
+        }
+        let (send, receive) = mpsc::channel();
+        let ctx = ctx.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            let _ = send.send(web::open_bytes(bytes));
+            ctx.request_repaint();
+        });
+        self.job = Some(Job { receiver: receive, revision, operation: "open", destination: None, download: None });
+        Ok(())
+    }
