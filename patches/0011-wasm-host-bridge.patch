+//! The page's own project route across the WebAssembly boundary.
+//!
+//! Why: when this app runs as a page inside a host product, the host loads and saves the
+//! session's project through its own routes instead of the browser's file dialog and download
+//! UI. The page calls the `pcbz_host_*` exports of `apps/pcbcraft-web`; each queues one request
+//! here and the editor's next frame handles it through the same paths a menu action would. A
+//! plain browser build keeps the file dialog and the download as fallbacks, so only the edges
+//! differ from the desktop behaviour.
+
+use std::sync::{Arc, Mutex};
+
+/// One request from the page, handled on the editor thread.
+#[derive(Debug)]
+pub(crate) enum Request {
+    /// Project bytes the host pushed; they open through the browser upload path.
+    Open(Arc<[u8]>),
+    /// Start the browser save; its bytes go to the host's `pcbzOnSave` callback.
+    Save,
+    /// Run a catalog command, exactly as a menu item does.
+    Command { id: String, params: String },
+}
+
+static REQUESTS: Mutex<Vec<Request>> = Mutex::new(Vec::new());
+
+/// The last editor state the page may ask for without reaching into the app.
+static STATUS: Mutex<String> = Mutex::new(String::new());
+
+fn push(request: Request) {
+    if let Ok(mut queue) = REQUESTS.lock() {
+        queue.push(request);
+    }
+}
+
+/// Queue project bytes for the next frame; called by the `pcbz_host_open` export.
+pub fn queue_open(bytes: &[u8]) {
+    push(Request::Open(Arc::from(bytes)));
+}
+
+/// Queue a save for the next frame; called by the `pcbz_host_save` export.
+pub fn queue_save() {
+    push(Request::Save);
+}
+
+/// Queue a catalog command for the next frame; called by the `pcbz_host_command` export.
+pub fn queue_command(id: &str, params: &str) {
+    push(Request::Command { id: id.to_owned(), params: params.to_owned() });
+}
+
+/// Take the oldest request; `None` when the page queued nothing.
+pub(crate) fn take() -> Option<Request> {
+    let mut queue = REQUESTS.lock().ok()?;
+    if queue.is_empty() { None } else { Some(queue.remove(0)) }
+}
+
+/// Keep a request the editor could not start yet at the back of the queue.
+pub(crate) fn retry(request: Request) {
+    push(request);
+}
+
+/// Publish the state the page polls between a load, an edit and a save.
+pub(crate) fn publish_status(text: String) {
+    if let Ok(mut status) = STATUS.lock() {
+        *status = text;
+    }
+}
+
+/// The last published editor state as JSON; the `pcbz_host_status` export returns it.
+pub fn status() -> String {
+    STATUS.lock().map(|status| (*status).clone()).unwrap_or_default()
+}
