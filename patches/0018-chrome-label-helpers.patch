+fn translated(label: WidgetText) -> WidgetText {
+    let text = label.text();
+    let shown = crate::i18n::tr_label(text);
+    if std::ptr::eq(shown.as_ptr(), text.as_ptr()) { label } else { WidgetText::from(shown.to_owned()) }
+}
